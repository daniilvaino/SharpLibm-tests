<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host-side checks of SharpLibm. SharpLibmRoot is the SharpLibm checkout
       (default: the submodule of a SharpOS checkout next to this repository,
       ..\..\OS\SharpLibm); the first program argument is the suites directory. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <SharpLibmDefineRuntimeExport>true</SharpLibmDefineRuntimeExport>
    <SharpLibmExports>true</SharpLibmExports>
    <SharpLibmRoot Condition="'$(SharpLibmRoot)' == ''">$(MSBuildThisFileDirectory)..\..\OS\SharpLibm\</SharpLibmRoot>
  </PropertyGroup>

  <Import Project="$(SharpLibmRoot)SharpLibm.props" />

</Project>
